# Shared database connection (used by @ss/db and all apps)
POSTGRES_URL=

# Signs the short-lived device tokens the company extras and the ask are
# answered under: any long random string locally. Without it no token is
# issued, so the extras never load and the box never offers to ask.
ENGAGE_TOKEN_SECRET=

# The ask's judge: the key its engine reaches the model with, for the ask
# server fns and the local evals. A key of this repo's own, never the firewall's.
ASK_API_KEY=

# Local runs only: 1 lets every visitor of the dev server ask the search box a
# question. Production ignores it; there the owner cookie gates asking, unless
# asking is public (below). Asking also needs ENGAGE_TOKEN_SECRET (above):
# without it no token is issued and the box never offers, whatever this
# switch says.
ASK_LOCAL_OPEN=

# 1 offers asking to every visitor. Read at build, so a change needs a new
# build. Unset, only the owner is offered it.
VITE_ASK_PUBLIC=

# The tokens a visitor's device may have the judge use in a day before it
# waits a day: a whole number, with no separators. A visitor is never answered
# without it, whatever the switch above says; the owner asks without one.
# Needs the ask_usage table (db:migrate).
ASK_DAILY_TOKENS=

# The same for every device asking from one network address together, and for
# every visitor of the site together: whole numbers, with no separators. A
# visitor is never answered without all three.
ASK_DAILY_TOKENS_NETWORK=
ASK_DAILY_TOKENS_SITE=

# Desktop release pipeline — set in the Vercel project env + GitHub Actions
# secrets (not needed for local web dev):
#   BLOB_READ_WRITE_TOKEN  — Vercel Blob token (auto-injected once a Blob store
#                            is linked); the release workflow uploads installers with it.
#   BLOB_PUBLIC_BASE       — the Blob store's public host
#                            (https://<id>.public.blob.vercel-storage.com); the
#                            Nitro /downloads/... route 302-redirects here.
#   DESKTOP_RELEASE_SECRET — shared secret the workflow sends as
#                            x-desktop-release-secret to POST /api/releases.
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE=
DESKTOP_RELEASE_SECRET=
