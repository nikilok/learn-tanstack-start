# Shared database connection (used by @ss/db and all apps)
POSTGRES_URL=

# Desktop release pipeline — set in the Vercel project env + GitHub Actions
# secrets (not needed for local web dev):
#   BLOB_READ_WRITE_TOKEN  — Vercel Blob token (auto-injected once a Blob store
#                            is linked); the release workflow uploads installers with it.
#   BLOB_PUBLIC_BASE       — the Blob store's public host
#                            (https://<id>.public.blob.vercel-storage.com); the
#                            Nitro /downloads/... route 302-redirects here.
#   DESKTOP_RELEASE_SECRET — shared secret the workflow sends as
#                            x-desktop-release-secret to POST /api/releases.
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE=
DESKTOP_RELEASE_SECRET=

# Firewall rule manager (`bun run firewall:setup`) — only needed to manage the WAF.
# VALUES ARE DELIBERATELY OMITTED HERE: the ceilings live in .env.local so the public
# repo never reveals the thresholds a scraper would pace itself under. Calibrate them
# from the report pane ('r'), which measures real peak per-IP burst and 10-minute volume.
#   VERCEL_TOKEN                 — personal/team token (vercel.com/account/tokens);
#                                  VERCEL_OIDC_TOKEN does NOT authorize these REST calls.
#   FW_OPS_PATH                  — ABSOLUTE path to the private sponsorsearch-ops checkout.
#                                Holds the mock-mode cassettes. Optional: without it the tool
#                                looks for a sibling directory containing
#                                firewall-operator/SKILL.md.
#   FW_SERVERFN_LIMIT            — /_serverFn per-IP BURST ceiling, requests per 60s
#   FW_SERVERFN_SUSTAINED_LIMIT  — /_serverFn per-IP SUSTAINED ceiling, per 600s (REQUIRED:
#                                  it holds the flat-rate line the raised burst tier gives
#                                  up, so the apply aborts rather than ship burst-only)
#   FW_SEARCH_LIMIT              — SSR /?search= per-IP burst ceiling, per 60s
#   FW_SEARCH_SUSTAINED_LIMIT    — SSR /?search= per-IP sustained ceiling, per 600s (REQUIRED)
#   FW_TILES_LIMIT               — /api/tiles per-IP ceiling, per 60s
#   FW_JA4_LIMIT                 — per-JA4 observation threshold, per 60s (log-only rule)
#   FW_DOWNLOADS_LIMIT           — /downloads/{mac,win,linux}/ per-IP ceiling, per 60s
#                                  (optional — unset just omits that one rule)
# 600s is the max counting window on Vercel Pro; 1h needs Enterprise.
