# Shared database connection (used by @ss/db and all apps)
POSTGRES_URL=

# The ask's judge: the key its engine reaches the model with, for the ask
# server fns and the local evals. A key of this repo's own, never the firewall's.
ASK_API_KEY=

# Local runs only: 1 lets every visitor of the dev server ask the search box a
# question. Production ignores it; there the owner cookie gates asking. Asking
# also needs ENGAGE_TOKEN_SECRET (above the company extras share): without it
# no token is issued and the box never offers, whatever this switch says.
ASK_LOCAL_OPEN=

# Desktop release pipeline — set in the Vercel project env + GitHub Actions
# secrets (not needed for local web dev):
#   BLOB_READ_WRITE_TOKEN  — Vercel Blob token (auto-injected once a Blob store
#                            is linked); the release workflow uploads installers with it.
#   BLOB_PUBLIC_BASE       — the Blob store's public host
#                            (https://<id>.public.blob.vercel-storage.com); the
#                            Nitro /downloads/... route 302-redirects here.
#   DESKTOP_RELEASE_SECRET — shared secret the workflow sends as
#                            x-desktop-release-secret to POST /api/releases.
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE=
DESKTOP_RELEASE_SECRET=
