{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "apps/web/src/styles.css",
    "functions": ["clsx", "cn"]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/.vercel/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/.vinxi/**",
    "apps/web/src/routeTree.gen.ts",
    "**/*.md",
    "**/*.mdx"
  ]
}
