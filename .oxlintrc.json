{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/.vercel/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/.vinxi/**",
    "apps/web/src/routeTree.gen.ts"
  ]
}
