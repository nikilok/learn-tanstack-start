# Anthropic API key (used by agentic scripts: find-hmrc-csv-url, lookup-company)
ANTHROPIC_API_KEY=

# Companies House API key (used at runtime for company profile lookups)
COMPANIES_HOUSE_API_KEY=

# Separate Companies House API key for bulk seeding (higher rate limit)
COMPANIES_HOUSE_SEED_API_KEY=

# Vercel Flags SDK signing secret. Auto-created by the Flags Explorer
# onboarding flow; pull locally with `vercel env pull`. Used to verify the
# /.well-known/vercel/flags Authorization header and the
# vercel-flag-overrides cookie signature.
FLAGS_SECRET=

# Vercel Edge Config connection URL (read access embedded). Auto-injected
# when an Edge Config is linked to the project in the Vercel dashboard;
# pull locally with `vercel env pull`. Source of truth for flag values
# read by src/flags.server.ts.
EDGE_CONFIG=
