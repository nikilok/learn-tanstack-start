{
  "name": "learning-tanstack-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:ch-stream": "turbo run dev --filter @ss/ch-stream",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate --filter @ss/web",
    "db:create-migration": "turbo run db:create-migration --filter @ss/web",
    "db:migrate": "turbo run db:migrate --filter @ss/web",
    "db:push": "turbo run db:push --filter @ss/web",
    "db:studio": "turbo run db:studio --filter @ss/web",
    "knip": "knip"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.25",
    "@tanstack/start-server-core": "^1.169.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "knip": "^6.14.1",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.13",
  "overrides": {
    "@tanstack/start-server-core": "link:@tanstack/start-server-core",
    "@tanstack/react-router": "link:@tanstack/react-router",
    "@tanstack/router-core": "link:@tanstack/router-core"
  }
}
