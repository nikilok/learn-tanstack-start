{
  "name": "learning-tanstack-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "db:create-migration": "turbo run db:create-migration --filter @ss/web",
    "db:generate": "turbo run db:generate --filter @ss/web",
    "db:migrate": "turbo run db:migrate --filter @ss/web",
    "db:push": "turbo run db:push --filter @ss/web",
    "db:studio": "turbo run db:studio --filter @ss/web",
    "dev": "turbo run dev --filter=!@ss/desktop",
    "dev:ch-stream": "turbo run dev --filter @ss/ch-stream",
    "dev:desktop": "turbo run dev --filter @ss/desktop",
    "dev:desktop:offline": "DESKTOP_SIMULATE_OFFLINE=1 turbo run dev --filter @ss/desktop",
    "dev:desktop:ratelimit": "DESKTOP_SIMULATE_RATE_LIMIT=1 turbo run dev --filter @ss/desktop",
    "dev:desktop:unreachable": "DESKTOP_SIMULATE_UNREACHABLE=1 turbo run dev --filter @ss/desktop",
    "firewall:ip": "bun --env-file=.env.local apps/firewall/src/profile.ts",
    "firewall:setup": "bun --env-file=.env.local apps/firewall/src/setup.tsx",
    "firewall:mock": "bun --no-env-file apps/firewall/src/setup.tsx --mock",
    "firewall:record": "bun --env-file=.env.local apps/firewall/src/setup.tsx --record",
    "firewall:synth": "bun --no-env-file apps/firewall/src/synth.ts",
    "firewall:sitemap": "bun --env-file=.env.local apps/firewall/src/sitemap.ts",
    "firewall:watch": "bun --env-file=.env.local apps/firewall/src/watch.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "profiles:work": "bun apps/web/scripts/profile-company.ts --work",
    "test": "turbo run test",
    "firewall:verify": "bun --env-file=.env.local apps/firewall/src/verify.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "knip": "^6.14.1",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.13",
  "trustedDependencies": [
    "electron"
  ]
}
